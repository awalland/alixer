# Copy to publish.env next to this file and fill in. Keep it mode 600 and never
# commit it (.gitignore covers the name):
#   install -m 600 publish.env.example publish.env
# $EDITOR publish.env
#
# Token: Gitea -> Settings -> Applications -> Generate Token, scoped to
# write:package (add read:package only if you want to list packages).
GITEA_BASE_URL=https://git.home
GITEA_USERNAME=changeme
GITEA_PACKAGE_OWNER=stuff
GITEA_TOKEN=changeme
